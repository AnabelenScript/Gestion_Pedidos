# Puertos
ORDERS_PORT=3000
INVENTORY_PORT=3001
PAYMENTS_PORT=3002
REDIS_PORT=6379

# Credenciales internas; reemplaza ambos valores antes de ejecutar el proyecto.
JWT_SECRET=reemplaza-este-secreto-jwt-de-al-menos-32-caracteres
INTERNAL_API_KEY=reemplaza-esta-api-key-interna-de-al-menos-32-caracteres
ENABLE_DEV_AUTH=true

# Base de datos de Orders
ORDERS_DATABASE_HOST=host.docker.internal
ORDERS_DATABASE_PORT=5432
ORDERS_DATABASE_USER=orders_user
ORDERS_DATABASE_PASS=reemplaza-esta-contrasena
ORDERS_DATABASE_NAME=orders_db
ORDERS_DATABASE_SSL=false
ORDERS_DATABASE_SSL_REJECT_UNAUTHORIZED=true
ORDERS_DATABASE_SYNCHRONIZE=false
ORDERS_DATABASE_RUN_MIGRATIONS=true

# Base de datos de Inventory
INVENTORY_DATABASE_HOST=host.docker.internal
INVENTORY_DATABASE_PORT=5432
INVENTORY_DATABASE_USER=inventory_user
INVENTORY_DATABASE_PASS=reemplaza-esta-contrasena
INVENTORY_DATABASE_NAME=inventory_db
INVENTORY_DATABASE_SSL=false
INVENTORY_DATABASE_SSL_REJECT_UNAUTHORIZED=true
INVENTORY_DATABASE_SYNCHRONIZE=false
INVENTORY_DATABASE_RUN_MIGRATIONS=true
SEED_DEMO_DATA=true

# Base de datos de Payments
PAYMENTS_DATABASE_HOST=host.docker.internal
PAYMENTS_DATABASE_PORT=5432
PAYMENTS_DATABASE_USER=payments_user
PAYMENTS_DATABASE_PASS=reemplaza-esta-contrasena
PAYMENTS_DATABASE_NAME=payments_db
PAYMENTS_DATABASE_SSL=false
PAYMENTS_DATABASE_SSL_REJECT_UNAUTHORIZED=true
PAYMENTS_DATABASE_SYNCHRONIZE=false
PAYMENTS_DATABASE_RUN_MIGRATIONS=true
